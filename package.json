{
  "name": "kea-disposables",
  "version": "1.0.0",
  "description": "Kea plugin for automatic resource cleanup. Register timers, listeners and subscriptions with a setup function that returns a cleanup function \u2014 teardown runs on unmount, and background work auto-pauses while the tab is hidden.",
  "license": "MIT",
  "author": "PostHog <hey@posthog.com>",
  "contributors": [
    "Paul D'Ambra <paul@posthog.com>",
    "Marius Andra <marius.andra@gmail.com>",
    "Julian Bez <julian@posthog.com>",
    "Sam Pennington <sam@posthog.com>",
    "Rafa Audibert <rafael@posthog.com>"
  ],
  "homepage": "https://github.com/PostHog/kea-disposables#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostHog/kea-disposables.git"
  },
  "bugs": {
    "url": "https://github.com/PostHog/kea-disposables/issues"
  },
  "keywords": [
    "kea",
    "kea-plugin",
    "disposables",
    "cleanup",
    "teardown",
    "setinterval",
    "polling",
    "visibilitychange",
    "redux",
    "posthog"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:dist": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "kea": ">= 3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "kea": "^3.1.7",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.74.0",
    "publint": "^0.3.21",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.mjs"
}
